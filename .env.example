# Supabase Dashboard > Connect > Transaction pooler (port 6543). Add sslmode=require.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@HOST:6543/postgres?sslmode=require
DATABASE_POOL_SIZE=1

# Required and stable in production. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Required and stable in production. Generate with: openssl rand -base64 32
TEACHER_PASSWORD_VAULT_KEY=

# Used only by npm run admin:create.
ADMIN_INITIAL_PASSWORD=

# Set only when a local PostgreSQL server does not use TLS.
# DATABASE_SSL=false
